{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(bash scripts/gates.sh:*)",
      "Bash(bash scripts/doctor.sh:*)",
      "Bash(bash scripts/ledger.sh:*)",
      "Bash(bash scripts/branch-state.sh:*)",
      "Bash(bash scripts/same-everywhere.sh:*)",
      "Bash(bash scripts/eval-runner.sh:*)",
      "Bash(bash scripts/learn-check.sh:*)",
      "Bash(bash scripts/agent-config-diff.sh:*)",
      "Bash(bash evals/run.sh:*)",
      "Bash(node scripts/autopilot.mjs:*)",
      "Bash(node scripts/learn.mjs:*)",
      "Bash(node scripts/clock-boundary.mjs:*)",
      "Bash(node scripts/ci-trigger.mjs:*)",
      "Bash(node scripts/mutate.mjs:*)",
      "Bash(node scripts/smoke.mjs:*)",
      "Bash(node scripts/churn-check.mjs:*)",
      "Bash(node scripts/config.mjs:*)",
      "Bash(node scripts/fold-logs.mjs:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/log-usage.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate-stop.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/record-subagent.sh"
          }
        ]
      }
    ]
  }
}
