# このファイルを .env にコピーして値を埋める:  cp config.example.env .env
# .env は .gitignore 済み。リポジトリには絶対にコミットしないこと。

# ---- hacomono (品川ゴルフセンター) ----
HACOMONO_BASE_URL=https://shinagawa-golf-center.hacomono.jp
HACOMONO_EMAIL=your-login-email@example.com
HACOMONO_PASSWORD=your-password
# ログインページのパス(店舗により /login か /mypage/login)
HACOMONO_LOGIN_PATH=/login

# ---- 狙う枠 ----
# スケジュールページのパス(URLの https://...hacomono.jp 以降)
TARGET_SCHEDULE_PATH=/reserve/schedule/1/2
# 狙う日付(URLの date_from に入る値)
TARGET_DATE=2026-07-15
# 狙う開始時刻。カンマ区切りで複数可。空にするとその日の空き枠ならどれでも取る
TARGET_TIMES=10:00,11:00

# ---- 動作設定 ----
# 1 = 予約確定ボタンの直前で止めてスクショだけ撮る(まずは必ず1で動作確認する)
DRY_RUN=1
# 0 にするとブラウザ画面を表示しながら動く(セレクタ調整時に便利)
HEADLESS=1
# サイトを直接ポーリングする間隔(秒)。短くしすぎない(サーバー負荷・BAN回避)
POLL_INTERVAL_SEC=60

# ---- Gmailトリガー(任意だが推奨: キャンセル通知メール着信で即座に予約を試行) ----
# Googleアカウントで2段階認証を有効にし「アプリパスワード」を発行して設定する
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=takeshi.music.5@gmail.com
GMAIL_APP_PASSWORD=
# この文字列が差出人か件名に含まれるメールをトリガーにする(カンマ区切りでOR条件)
GMAIL_MATCH=hacomono,キャンセル
# 1 = 予約成功/失敗を自分宛てにメール通知する(GMAIL_APP_PASSWORD が必要)
NOTIFY_EMAIL=1
